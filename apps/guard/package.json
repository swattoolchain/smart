{
  "name": "@tharam/guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tharam Store Guard - functional, regression and non-functional monitoring for Shopify stores",
  "scripts": {
    "start": "node src/server.js",
    "mock": "node test/mock-store.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/lib/reporter.js --test-reporter-destination=test-results/reporter.log \"test/*.test.js\"",
    "verify": "node src/verify.js",
    "test:engine": "node --test --test-reporter=spec test/engine.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cookie-session": "^2.1.0",
    "express": "^5.3.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pixelmatch": "^6.0.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0"
  }
}
